{
  "name": "flusec",
  "displayName": "FluSec",
  "description": "Flutter security analysis VS Code extension with LLM-driven educational feedback.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dart"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flusec.scanFile",
        "title": "FluSec: Scan Current File"
      },
      {
        "command": "flusec.scanProject",
        "title": "FluSec: Scan Entire Project"
      },
      {
        "command": "flusec.openFindings",
        "title": "FluSec: Open HSD Dashboard"
      },
      {
        "command": "flusec.openNetDashboard",
        "title": "FluSec: Open NET Dashboard"
      },
      {
        "command": "flusec.openIDSDashboard",
        "title": "FluSec: Open IDS Dashboard"
      },
      {
        "command": "flusec.openIIVDashboard",
        "title": "FluSec: Open IIV Dashboard"
      },
      {
        "command": "flusec.updateRulePacks",
        "title": "FluSec: Sync Policies"
      },
      {
        "command": "flusec.uploadFindings",
        "title": "FluSec: Sync Findings to Team"
      },
      {
        "command": "flusec.loginToTeam",
        "title": "FluSec: Login to Team"
      },
      {
        "command": "flusec.logoutFromTeam",
        "title": "FluSec: Logout from Team"
      }
    ],
    "configuration": {
      "title": "FLUSEC",
      "properties": {
        "flusec.webApiEndpoint": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "FluSec Web Platform API base URL.",
          "scope": "application"
        },
        "flusec.supabaseUrl": {
          "type": "string",
          "default": "https://rlqfktxtgptsyuacqtve.supabase.co",
          "description": "Supabase project URL."
        },
        "flusec.supabaseAnonKey": {
          "type": "string",
          "default": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJscWZrdHh0Z3B0c3l1YWNxdHZlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzIxMDY1ODMsImV4cCI6MjA4NzY4MjU4M30.jPzakW2dM42VoCFbtmpWnPCqvxJCPAJnVZ5u8bLZNX0",
          "description": "Supabase anon key used for extension-side login flow."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flusec",
          "title": "FLUSEC",
          "icon": "resources/programming-security-svgrepo-com.svg"
        }
      ]
    },
    "views": {
      "flusec": [
        {
          "id": "flusecNavView",
          "name": "FLUSEC Navigation"
        }
      ]
    }
  },
  "files": [
    "dist",
    "web",
    "dart-analyzer",
    "resources"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}