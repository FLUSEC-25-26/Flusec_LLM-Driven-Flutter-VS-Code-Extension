{
  "name": "flusec",
  "displayName": "FluSec",
  "description": "Flutter security analysis VS Code extension with educational feedback and team policy synchronization.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dart",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flusec.scanFile",
        "title": "FluSec: Scan Current File"
      },
      {
        "command": "flusec.scanProject",
        "title": "FluSec: Scan Entire Project"
      },
      {
        "command": "flusec.manageRules",
        "title": "FluSec: Open HSD Rule Manager"
      },
      {
        "command": "flusec.openFindings",
        "title": "FluSec: Open HSD Dashboard"
      },
      {
        "command": "flusec.openNetDashboard",
        "title": "FluSec: Open NET Dashboard"
      },
      {
        "command": "flusec.openIDSDashboard",
        "title": "FluSec: Open IDS Dashboard"
      },
      {
        "command": "flusec.openIIVDashboard",
        "title": "FluSec: Open IIV Dashboard"
      },
      {
        "command": "flusec.updateRulePacks",
        "title": "FluSec: Sync Policies"
      },
      {
        "command": "flusec.uploadFindings",
        "title": "FluSec: Sync Findings to Team"
      },
      {
        "command": "flusec.loginToTeam",
        "title": "FluSec: Connect Account"
      },
      {
        "command": "flusec.switchTeam",
        "title": "FluSec: Switch Team"
      },
      {
        "command": "flusec.logoutFromTeam",
        "title": "FluSec: Disconnect Account"
      },
      {
        "command": "flusec.selectLlmProvider",
        "title": "FluSec: Select LLM Feedback Provider"
      },
      {
        "command": "flusec.testLlmProvider",
        "title": "FluSec: Test LLM Feedback Provider"
      },
      {
        "command": "flusec.runLlmEvaluation",
        "title": "FLUSEC: Run Automated LLM Evaluation"
      }
    ],
    "configuration": {
      "title": "FLUSEC",
      "properties": {
        "flusec.ruleRepoBaseUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/FLUSEC-25-26/flusec-rulepacks/main",
          "description": "Base URL for legacy rule-pack synchronization.",
          "scope": "application"
        },
        "flusec.cloudUploadEndpoint": {
          "type": "string",
          "default": "http://localhost:8082",
          "description": "Legacy FLUSEC cloud API setting retained for compatibility.",
          "scope": "application"
        },
        "flusec.webApiEndpoint": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "FLUSEC backend API base URL.",
          "scope": "application"
        },
        "flusec.webAppUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "FLUSEC web application URL used for browser-based account connection.",
          "scope": "application"
        },
        "flusec.supabaseUrl": {
          "type": "string",
          "default": "https://rlqfktxtgptsyuacqtve.supabase.co",
          "description": "Supabase project URL used by the OAuth 2.1 authorization server.",
          "scope": "application"
        },
        "flusec.oauthClientId": {
          "type": "string",
          "default": "b338b6df-e0f9-4e03-b57f-4eb47e086782",
          "description": "Public OAuth client ID registered for the FLUSEC VS Code extension. No client secret is stored in the extension.",
          "scope": "application"
        },
        "flusec.llmProvider": {
          "type": "string",
          "enum": [
            "vscode",
            "ollama",
            "disabled"
          ],
          "default": "vscode",
          "enumDescriptions": [
            "Use a language model exposed through VS Code's Language Model API. This is the default.",
            "Use a locally running Ollama server.",
            "Disable LLM educational feedback. FLUSEC static analysis continues normally."
          ],
          "description": "Provider used only for optional FLUSEC educational feedback. Static detection does not depend on this setting.",
          "scope": "application"
        },
        "flusec.vscodeLmVendor": {
          "type": "string",
          "default": "copilot",
          "description": "Preferred VS Code language-model vendor. If unavailable, FLUSEC can use another model exposed through the VS Code Language Model API.",
          "scope": "application"
        },
        "flusec.vscodeLmModelId": {
          "type": "string",
          "default": "",
          "description": "Optional exact VS Code language-model ID. Leave empty to let FLUSEC choose an available model.",
          "scope": "application"
        },
        "flusec.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama base URL used when the LLM provider is set to Ollama. Keep localhost for local-only feedback.",
          "scope": "application"
        },
        "flusec.ollamaModel": {
          "type": "string",
          "default": "llama3.2:latest",
          "description": "Ollama model used for FLUSEC educational feedback.",
          "scope": "application"
        },
        "flusec.llmTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 180,
          "description": "Maximum time FLUSEC waits for one LLM educational-feedback request.",
          "scope": "application"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flusec",
          "title": "FLUSEC",
          "icon": "resources/programming-security-svgrepo-com.svg"
        }
      ]
    },
    "views": {
      "flusec": [
        {
          "id": "flusecNavView",
          "name": "FLUSEC Navigation"
        }
      ]
    }
  },
  "files": [
    "dist",
    "web",
    "dart-analyzer",
    "evaluation",
    "resources"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
